{
  "name": "creator-pulse",
  "version": "0.1.0",
  "private": true,
  "description": "CreatorPulse modular monolith foundation",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,api,worker \"npm run dev --workspace @creator-pulse/web\" \"npm run dev --workspace @creator-pulse/api\" \"npm run dev --workspace @creator-pulse/worker\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:qa02": "playwright test tests/e2e/qa02.spec.ts",
    "test:qa03": "vitest run tests/qa03-resilience.test.ts",
    "qa03:baseline": "npm run build --workspace @creator-pulse/contracts && npm run build --workspace @creator-pulse/api && npm run build --workspace @creator-pulse/worker && node scripts/qa03-baseline.mjs",
    "test:qa04": "vitest run tests/qa04-quality-review.test.ts",
    "qa04:review": "npm run build --workspace @creator-pulse/contracts && node scripts/qa04-quality-review.mjs",
    "test:watch": "vitest",
    "test:bootstrap": "node scripts/bootstrap-check.mjs",
    "test:cp01": "node scripts/cp01-check.mjs",
    "check:architecture": "node scripts/architecture-check.mjs",
    "test:compose": "node scripts/compose-smoke.mjs",
    "test:release": "node scripts/release-check.mjs",
    "backup:create": "node scripts/backup.mjs create",
    "backup:verify": "node scripts/backup.mjs verify",
    "backup:restore-mongo": "node scripts/backup.mjs restore-mongo",
    "test:rel02": "node scripts/rel02-check.mjs",
    "test:rel03": "node scripts/rel03-check.mjs",
    "release:readiness": "node scripts/release-readiness.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/db-seed.mjs",
    "credits:grant-existing": "node --env-file-if-exists=.env scripts/grant-existing-user-credits.mjs",
    "test:db": "node scripts/db-live-smoke.mjs",
    "check:ci": "node scripts/ci-check.mjs",
    "test:ci-failures": "node scripts/ci-failure-paths.mjs",
    "test:language-eval": "node scripts/language-evaluation.mjs --report .ci-artifacts/language-evaluation.json",
    "test:rs02": "vitest run tests/rs02-feasibility.test.ts",
    "test:rs03": "vitest run tests/rs03-ingestion.test.ts",
    "test:rec01": "vitest run tests/rec01-ideas.test.ts",
    "test:rec02": "vitest run tests/rec02-scoring.test.ts",
    "test:rec03": "vitest run tests/rec03-recommendations.test.ts",
    "test:ai": "vitest run tests/ai.test.ts",
    "test:ai-poc": "npm run build --workspace @creator-pulse/contracts && npm run build --workspace @creator-pulse/worker && node scripts/ai-poc.mjs",
    "check:secrets": "node scripts/secret-check.mjs",
    "setup:hooks": "node scripts/setup-git-hooks.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:language-eval && npm run check:secrets && npm run test:bootstrap && npm run test:cp01 && npm run check:architecture && npm run test:compose && npm run check:ci"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
